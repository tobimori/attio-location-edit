{
  "name": "location-edit",
  "description": "Edit Location Attribute",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "attio": "attio",
    "dev": "attio dev",
    "build": "attio build",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf lib && rm -rf dist",
    "lint": "ATTIO_LINT_MODE='exhaustive' oxlint src/",
    "lint:fix": "ATTIO_LINT_MODE='exhaustive' oxlint --fix src/",
    "check": "npm run format:check && npm run lint",
    "check:fix": "npm run format && npm run lint:fix",
    "test": ""
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "node-fetch": "3.3.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "dependencies": {
    "attio": "^0.0.1-experimental.20250815.2",
    "react": "19.1.1",
    "zod": "4.0.17"
  }
}
