{
  "name": "location-edit",
  "description": "Edit Location Attribute",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "attio": "attio",
    "dev": "attio dev",
    "build": "attio build",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf lib && rm -rf dist",
    "lint": "ATTIO_LINT_MODE='exhaustive' oxlint src/",
    "lint:fix": "ATTIO_LINT_MODE='exhaustive' oxlint --fix src/",
    "check": "pnpm run format:check && pnpm run lint",
    "check:fix": "pnpm run format && pnpm run lint:fix",
    "test": ""
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "dependencies": {
    "attio": "1.0.1",
    "react": "19.2.8",
    "zod": "4.5.4"
  }
}
